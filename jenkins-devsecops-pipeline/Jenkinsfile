pipeline {
  agent any

  environment {
    REGISTRY = "<aws_account_id>.dkr.ecr.ap-south-1.amazonaws.com"
    IMAGE    = "demo-app"
    TAG      = "${env.BUILD_NUMBER}"
  }

  options {
    timestamps()
    disableConcurrentBuilds()
    timeout(time: 30, unit: 'MINUTES')
  }

  stages {
    stage('Checkout') {
      steps { checkout scm }
    }

    stage('Test') {
      steps {
        sh '''
          python3 -m venv .venv && . .venv/bin/activate
          pip install -r app/requirements.txt pytest
          pytest -q || echo "no tests yet"
        '''
      }
    }

    stage('SonarQube Analysis') {
      steps {
        withSonarQubeEnv('sonarqube') {
          sh 'sonar-scanner -Dsonar.projectKey=demo-app -Dsonar.sources=app'
        }
      }
    }

    stage('Quality Gate') {
      steps {
        timeout(time: 5, unit: 'MINUTES') { waitForQualityGate abortPipeline: true }
      }
    }

    stage('Docker Build') {
      steps { sh 'docker build -t $REGISTRY/$IMAGE:$TAG .' }
    }

    stage('Trivy Scan (gate)') {
      steps {
        // fail the build on fixable HIGH/CRITICAL findings
        sh 'trivy image --exit-code 1 --severity HIGH,CRITICAL --ignore-unfixed $REGISTRY/$IMAGE:$TAG'
      }
    }

    stage('Push to ECR') {
      steps {
        sh '''
          aws ecr get-login-password --region ap-south-1 | docker login --username AWS --password-stdin $REGISTRY
          docker push $REGISTRY/$IMAGE:$TAG
        '''
      }
    }

    stage('Deploy') {
      steps {
        sh '''
          sed "s|IMAGE_PLACEHOLDER|$REGISTRY/$IMAGE:$TAG|" k8s/deployment.yaml | kubectl apply -f -
          kubectl apply -f k8s/service.yaml -f k8s/hpa.yaml
          kubectl rollout status deployment/demo-app --timeout=120s
        '''
      }
    }
  }

  post {
    failure {
      sh 'kubectl rollout undo deployment/demo-app || true'
    }
    always { cleanWs() }
  }
}
